# ── Database ─────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string
# Get this from your Neon dashboard → Connection Details → Connection string
DATABASE_URL=postgresql://neondb_owner:password@ep-xxxx.eu-central-1.aws.neon.tech/portfolio?sslmode=require
# Alternative variable name (if you use NEON_DB instead)
# NEON_DB=postgresql://...


# ── Backblaze B2 (File Storage) ──────────────────────────────────────────────
# Create an application key at: https://secure.backblaze.com/app_keys.htm
# Bucket details: https://secure.backblaze.com/b2_buckets.htm
B2_ACCESS_KEY_ID=your-b2-application-key-id
B2_SECRET_ACCESS_KEY=your-b2-application-key-secret
B2_ENDPOINT=https://s3.YOUR-REGION.backblazeb2.com
B2_REGION=eu-central-003
B2_BUCKET_NAME=your-bucket-name

# ── Admin Dashboard ──────────────────────────────────────────────────────────
# The password used to log into the admin dashboard at /managesite
# This is prefixed with NEXT_PUBLIC_ so it's available client-side
NEXT_PUBLIC_ADMIN_PASSWORD=your-secure-admin-password

# ── Netlify-specific (optional) ──────────────────────────────────────────────
# NETLIFY_NEXT_SKEW_PROTECTION=true
